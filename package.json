{
  "name": "osa-mix",
  "version": "0.0.4",
  "description": "snippet library for fundamental functions",
  "keywords": [
    "snippet",
    "function"
  ],
  "license": "MIT",
  "author": "Olli Salmela",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test:once": "vitest run",
    "build:types": "tsc",
    "prebuild": "npm run test:once",
    "build": "npm run build:types && git add types",
    "post": "git push && git push --tags"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "exports": {
    "./pages": {
      "types": "./types/pages.d.ts",
      "import": "./src/pages.js"
    }
  },
  "homepage": "https://github.com/OliverStrait/osa-mix#readme",
  "bugs": {
    "url": "https://github.com/OliverStrait/osa-mix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OliverStrait/osa-mix.git"
  }
}
